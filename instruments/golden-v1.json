    {
      "id": "G-10",
      "phase": "P2",
      "name": "controlShare across a battle with pursuit",
      "spec": ["5.3", "5.4", "5.5"],
      "adr": "0021",
      "scenario": "three Direwolves squads raid an uncontested point; attacker's line wipes at t=60s; 20s pursuit",
      "timeline": [
        { "t": 30.0, "contribution": 600.0, "event": "24 models inside 8m; dwell starts" },
        { "t": 33.0, "contribution": 600.0, "event": "dwell complete; banking begins" },
        { "t": 50.0, "contribution": 500.0, "event": "squad A down to 4 models; still above 400" },
