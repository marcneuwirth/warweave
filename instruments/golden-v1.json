        { "weapon": "arrowLongbowmen",  "range": 14, "speed": 60, "flightTicks": 5,  "quantised": 0.25, "specPrints": 0.23 },
        { "weapon": "frostbolt",        "range": 24, "speed": 35, "flightTicks": 14, "quantised": 0.70, "specPrints": 0.69 },
