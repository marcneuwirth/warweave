      "bypassByDamageType": { "physical": 0.0, "magic": 0.5 },
      "minimumFinalDamage": 1,
      "floorApplications": 1,
      "aoeCatch": {
        "formula": "pi * r^2 / spacing^2",
        "singleModelSquadsCatchNothing": true,
        "specSection": "§22.4"
      },
      "overkillCarries": false,
      "distanceMeasurement": "surface-to-surface between collision circles; squad-to-squad is nearest-model to nearest-model"
    },

    "combat": {
      "flanking": {
        "bonus": 0.25,
        "frontalArcHalfAngleDegrees": 90,
        "testedPer": "attacking model",
        "specSection": "§23.2"
      },
      "stickiness": {
        "rearArcDamageBreaksOnce": true,
        "reacquireLockoutSeconds": 4.0,
        "reacquireTarget": "nearest enemy squad",
        "specSection": "§23.2"
      },
      "charging": {
        "minApproachSeconds": 1.5,
        "minApproachMetres": 6.0,
        "contactRangeMetres": 4.0,
