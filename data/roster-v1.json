      "holdBreak": {
        "controlPointExemptionRadiusMetres": 8.0,
        "specSection": "§23.3"
      }
    },

    "elemental": {
      "specSection": "§11",
      "allElementalDamageIsMagic": true,
      "burning": {
        "durationSeconds": 4.0,
        "damagePerSecond": 10,
        "damageType": "magic",
        "damagePool": "outside the applying attack's offensive pool — flat and source-independent",
        "regenerationReduction": 0.75,
        "reapplicationRefreshes": true,
        "stacksDamage": false
      },
      "chilled": {
        "durationSeconds": 3.0,
        "moveSpeedModifier": -0.2,
        "secondApplicationWhileActiveCausesFrozen": true,
        "consumedByFrozen": false
      },
      "frozen": {
        "durationSeconds": 0.75,
        "cannotMove": true,
        "attackTimerPauses": true,
        "tags": ["HardControl"],
        "exemptFromLargeHardControlDiscount": true,
        "uptimeCeilingSingleTarget": 0.375
      },
      "hardControl": {
        "immunitySecondsAfterExpiry": 1.25,
        "largeDurationMultiplier": 0.5,
        "largeDiscountLiveInV04": false,
        "taggedStatuses": ["Root", "Stun", "Frozen"],
        "note": "Root and Stun have no v0.4 applier; §12 is retained inert."
      },
      "shatter": {
        "bonus": 0.25,
        "requires": "an attack tagged Heavy against a Frozen target",
        "consumesFrozen": false,
        "pool": "offensive"
      },
      "deepChill": {
        "bonus": 0.25,
        "requires": "magic damage against a Frozen target",
        "requiresTag": null,
        "pool": "offensive"
      }
    },

    "projectiles": {
      "specSection": "§22.7",
      "homing": true,
      "canMiss": false,
      "fizzlesIfTargetDiesInFlight": true,
      "aoeResolvesAt": "impact point",
      "speedsMetresPerSecond": {
        "arrow": 60,
        "frostbolt": 35,
        "stormBolt": 35,
        "fireball": 30,
        "thrownStone": 25
      }
    },

    "magnitudeLadder": {
      "specSection": "§27.3",
      "bands": [
        { "upTo": 0.05, "readsAs": "inert", "example": "flat stat tweaks" },
        { "around": 0.10, "readsAs": "consistent, modest, never decisive", "example": "Phalanx, Grand Strategy" },
        { "around": 0.25, "readsAs": "a window created and cashed", "example": "Shatter, flanking" },
        { "from": 0.40, "readsAs": "flips a matchup", "example": "Bodkin 3, the three branch counters" }
      ]
    },

    "notCarriedHere": {
      "matchAndObjectiveConstants": "the round stake, battle damage, objective damage, battle-end and pursuit conditions, and the control point (§5) are match-loop values, owned by issue #36 rather than by this port. They belong in this file when #36 fixes them; a `match` block is the intended home.",
      "deploymentField": "field dimensions, deployment bands and the archetype coordinates are the separate versioned artifact docs/analysis/deployment-archetypes-v1.csv (#18).",
      "p3Payloads": "doctrine (§9) and hybrid-unlock (§10) effect payloads are P3 content, out of scope for this map. The affinity ladder below names them; nothing here authors what they do."
    }
  },

